# PROGRAM 10
# INTERQUARTILE RANGE AND STANDARD DEVIATION
# ============================================================

speed <- c(78.3,81.8,82,74.2,83.4,
           84.5,82.9,77.5,80.9,70.6)

# First Quartile
Q1 <- quantile(speed, 0.25)

# Third Quartile
Q3 <- quantile(speed, 0.75)

# Interquartile Range
IQR_value <- Q3 - Q1

print("Q1:")
print(Q1)

print("Q3:")
print(Q3)

print("Interquartile Range:")
print(IQR_value)

# Standard Deviation
standard_deviation <- sd(speed)

print("Standard Deviation:")
print(standard_deviation)

