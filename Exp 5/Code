# ============================================================
# PROGRAM 5
# AGE AND BODY FAT
# MEAN, MEDIAN, SD, BOXPLOT, SCATTER PLOT AND Q-Q PLOT
# ============================================================

# 18 sample values
age <- c(23,25,31,28,35,40,29,32,27,
         36,24,30,33,26,38,41,22,34)

fat <- c(18,21,25,22,28,31,24,26,20,
         29,19,23,27,21,30,32,17,25)

# Mean
print("Mean of Age:")
print(mean(age))

print("Mean of Body Fat:")
print(mean(fat))

# Median
print("Median of Age:")
print(median(age))

print("Median of Body Fat:")
print(median(fat))

# Standard Deviation
print("Standard Deviation of Age:")
print(sd(age))

print("Standard Deviation of Body Fat:")
print(sd(fat))


# Boxplot of Age
boxplot(age,
        main="Boxplot of Age",
        ylab="Age")


# Boxplot of Body Fat
boxplot(fat,
        main="Boxplot of Body Fat",
        ylab="Body Fat Percentage")


# Scatter Plot
plot(age, fat,
     main="Scatter Plot of Age and Body Fat",
     xlab="Age",
     ylab="Body Fat %",
     pch=19)


# Q-Q Plot for Age
qqnorm(age,
       main="Q-Q Plot of Age")

qqline(age)


# Q-Q Plot for Body Fat
qqnorm(fat,
       main="Q-Q Plot of Body Fat")

qqline(fat)
