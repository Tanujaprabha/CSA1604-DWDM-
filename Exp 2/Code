# ============================================================
# PROGRAM 2
# MEAN, MEDIAN, MODE, MIDRANGE, Q1 AND Q3
# ============================================================

age <- c(13,15,16,16,19,20,20,21,22,22,
         25,25,25,25,30,33,33,35,35,35,
         35,36,40,45,46,52,70)

# Mean
mean_value <- mean(age)
print("Mean:")
print(mean_value)

# Median
median_value <- median(age)
print("Median:")
print(median_value)

# Mode
frequency <- table(age)

mode_value <- names(frequency)[frequency == max(frequency)]

print("Mode:")
print(mode_value)

# Midrange
midrange <- (min(age) + max(age)) / 2

print("Midrange:")
print(midrange)

# First Quartile
Q1 <- quantile(age, 0.25)

# Third Quartile
Q3 <- quantile(age, 0.75)

print("Q1:")
print(Q1)

print("Q3:")
print(Q3)
