# PROGRAM 1
# APPROXIMATE MEDIAN FOR GROUPED DATA
# ============================================================

age_group <- c("1-5", "5-15", "15-20", "20-50", "50-80", "80-110")
frequency <- c(200, 450, 300, 1500, 700, 44)

cumulative_frequency <- cumsum(frequency)

N <- sum(frequency)

print("Total Frequency:")
print(N)

print("Cumulative Frequency:")
print(cumulative_frequency)

# Median class = 20-50
L <- 20
CF <- 950
f <- 1500
h <- 30

median_value <- L + ((N/2 - CF) / f) * h

print("Approximate Median:")
print(median_value)

